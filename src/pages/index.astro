<script is:inline>
(function(){
  var MADE=new Date(2026,5,8), FORCE=new Date(2027,3,6), TRANS=new Date(2027,9,6), PUB=new Date(2028,3,6);
  var today=new Date(); today.setHours(0,0,0,0);
  function fmt(d){return d.toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'});}
  function addDays(d,n){var x=new Date(d.getTime());x.setDate(x.getDate()+n);return x;}
  function daysUntil(d){return Math.round((d-today)/86400000);}

  /* countdown */
  var cd=document.getElementById('cd'), left=daysUntil(FORCE);
  cd.textContent=left>0?left:'0';
  if(left<=0){cd.nextElementSibling.textContent='the duty is in force';}


  /* motion: count-up and scroll reveal */
  var rm=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(!rm){
    var target=left>0?left:0, t0=null;
    function tick(ts){if(!t0)t0=ts;var p=Math.min(1,(ts-t0)/1400);var e=1-Math.pow(1-p,3);cd.textContent=Math.round(target*e);if(p<1)requestAnimationFrame(tick);}
    requestAnimationFrame(tick);
    if('IntersectionObserver' in window){
      var els=document.querySelectorAll('.rv');
      els.forEach(function(el){ if(el.getBoundingClientRect().top>window.innerHeight*0.9){el.classList.add('pre');} });
      var io=new IntersectionObserver(function(en){en.forEach(function(x){if(x.isIntersecting){x.target.classList.remove('pre');x.target.classList.add('in');io.unobserve(x.target);}});},{rootMargin:'0px 0px -8% 0px'});
      els.forEach(function(el){io.observe(el);});
      var stats=document.querySelectorAll('.stats .big');
      var so=new IntersectionObserver(function(en){en.forEach(function(x){if(!x.isIntersecting)return;var el=x.target,txt=el.textContent,n=parseInt(txt,10),suf=txt.replace(/^\d+/,'');var s0=null;(function run(ts){if(!s0)s0=ts;var p=Math.min(1,(ts-s0)/1100);el.textContent=Math.round(n*(1-Math.pow(1-p,3)))+suf;if(p<1)requestAnimationFrame(run);})(performance.now());so.unobserve(el);});},{threshold:.5});
      stats.forEach(function(el){so.observe(el);});
    }
  }

  /* timeline progress: four equal columns, today interpolated inside its span */
  var marks=[MADE,FORCE,TRANS,PUB], pct=0;
  for(var i=0;i<3;i++){ if(today>=marks[i]&&today<marks[i+1]){ pct=(i+(today-marks[i])/(marks[i+1]-marks[i]))/4*100; } }
  if(today>=PUB) pct=100;
  if(today<MADE) pct=0;
  var prog=document.getElementById('prog');
  requestAnimationFrame(function(){setTimeout(function(){prog.style.width=pct.toFixed(2)+'%';},200);});

  /* calculator */
  var ev=document.getElementById('event'), dt=document.getElementById('date'), pre=document.getElementById('pre');
  var rl=document.getElementById('r-label'), rd=document.getElementById('r-date'), rw=document.getElementById('r-why'), rr=document.getElementById('r-rule'), rb=document.getElementById('r-bar');
  function calc(){
    var v=dt.value; if(!v){return;}
    var p=v.split('-'); var d=new Date(+p[0],+p[1]-1,+p[2]);
    var e=ev.value, older=pre.value==='yes';
    var out, bar=0;
    if(e==='grant' && d<MADE){
      out={cls:'ok',label:'No duty on grant',date:'Not reportable',why:'The right was granted before the regulations were made on 8 June 2026, so the grant itself is outside the regime. A later assignment, written variation or exercise on or after 6 April 2027 would be reportable within 60 days of that event.',rule:'Transitional provisions · pre-8 Jun 2026 grants'};
    } else if(e!=='grant' && d<FORCE){
      out={cls:'ok',label:'Not a trigger',date:'Not reportable',why:'Assignments, variations and exercises only become reportable events on or after 6 April 2027. '+(older?'An older agreement is caught only by an event on or after that date.':'Check whether the original grant (8 June 2026 onward) needs reporting by 6 October 2027.'),rule:'Trigger events run from 6 Apr 2027'};
    } else if(e==='grant' && d<FORCE){
      var w=daysUntil(TRANS);
      out={cls:'red',label:'Submit to HMLR by',date:fmt(TRANS),why:'Granted during the transitional window (8 June 2026 to 5 April 2027). The HMLR digital service opens on 6 April 2027 and every transitional right must be submitted within six months of launch.',rule:'Transitional deadline · 6 Oct 2027 · '+(w>=0?w+' days from today':'deadline passed')};
      bar=Math.max(0,Math.min(100,(today-d)/(TRANS-d)*100));
    } else {
      var dl=addDays(d,60), left=daysUntil(dl);
      out={cls:'red',label:'Submit to HMLR by',date:fmt(dl),why:'The event falls after the regulations came into force, so the full regime applies: 60 calendar days from the date of the '+({grant:'grant',assign:'assignment',vary:'variation',exercise:'exercise'})[e]+'. Submission must be made digitally by an individually regulated conveyancer.',rule:'60 calendar days · '+fmt(d)+' + 60 · '+(left>=0?left+' days from today':'deadline passed')};
      bar=Math.max(0,Math.min(100,(today-d)/(dl-d)*100));
    }
    rl.textContent=out.label; rd.textContent=out.date; rd.className='big '+out.cls; rw.textContent=out.why; rr.textContent=out.rule;
    rb.style.width=bar.toFixed(1)+'%';
  }
  ev.addEventListener('change',calc); dt.addEventListener('change',calc); dt.addEventListener('input',calc); pre.addEventListener('change',calc);
  calc();

  /* Stripe Payment Links: paste the live URLs here; empty = fall back to the briefing form */
  var LINKS={reg:'',solo:'',pro:'',team:'',enterprise:'mailto:contact@landcontrol.co.uk?subject=LandControl%20Enterprise'};
  document.querySelectorAll('a.buy').forEach(function(a){var k=a.getAttribute('data-plan');if(LINKS[k]){a.setAttribute('href',LINKS[k]);if(LINKS[k].indexOf('http')===0){a.setAttribute('target','_blank');a.setAttribute('rel','noopener');}}});
  var f=document.getElementById('signup');
  f.addEventListener('submit',function(x){x.preventDefault();document.getElementById('msg').hidden=false;f.querySelector('button').textContent='Joined';});
})();
</script>
